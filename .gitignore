# Secrets — NEVER commit (see 06_DATA_PRIVACY_AND_RELEASE_SAFETY.md)
.env
*.key
kaggle.json
*_token*
.hf_token

# Raw data (may contain PII before scrubbing) + large artifacts
data/raw/
*.csv
!kcc_sample_ILLUSTRATIVE.csv
*.safetensors
*.gguf
*.bin
checkpoints/
wandb/

# Held-out eval set — only the GENERATED data files are private (so they
# can't leak into anyone's training); docs/scripts describing the audit
# process (LEAKAGE_AUDIT.md, HASHES.md, build_test_set.py, D3_FLAGGED.md)
# are meant to be tracked and public. A bare `eval/heldout/` here used to
# gitignore the whole directory, which silently hid new files added under
# it (you'd `git add` and nothing would happen, no error) -- narrowed to
# just the data files it actually needs to keep private.
eval/heldout/*.jsonl

# Generated artifacts (the released dataset goes to HF/Kaggle, not git)
dataset/*.jsonl
eval/out*.jsonl
eval/out/

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS
.DS_Store
08_MILESTONE_LOG.md
fasal-kcc-instruct/
.fuse_hidden*
!eval/reports/judge_anchor_scores.csv
