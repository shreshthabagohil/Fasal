# Copy to .env and fill in. .env is gitignored — real values NEVER get committed.
# If a token is ever committed by accident, ROTATE it (deletion isn't enough).

HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
ADAPTION_API_KEY=
WANDB_API_KEY=
# Comma-separated pool of free-tier keys for the LLM-judge eval (eval/judge.py). One per
# teammate/account, zero cost. Groq alone can't cover a full held-out run in a day (see
# eval/JUDGE_BUDGET.md) — pool Cerebras keys too for a much larger daily token budget.
GROQ_API_KEYS=
CEREBRAS_API_KEYS=

# Fixed seed for the whole project — change deliberately, record when you do.
# LOCKED per train/A0_LOCKED.md + 02_EXECUTION_PLAN.md §6.5 — do not change without a Planning-session decision.
GLOBAL_SEED=1729
